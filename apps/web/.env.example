# API base URL. Locally, the one from `make up` or `uvicorn main:app`.
# The web and the API must share a "site" (the same registrable domain) so that
# the SameSite=Lax refresh cookie travels: localhost:5173 and localhost:8000 do,
# and in production ygg.yourdomain.dev and api.ygg.yourdomain.dev do too.
VITE_API_URL=http://localhost:8000

# Public demo (optional). If defined, the login shows these credentials and
# a button to sign in. They are public on purpose: the API with DEMO_MODE=true is
# read-only. Do not put the credentials of a real account here.
# VITE_DEMO_EMAIL=demo@ygg.gg
# VITE_DEMO_PASSWORD=

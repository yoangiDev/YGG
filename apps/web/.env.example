# URL base de la API. En local, la de `make up` o `uvicorn main:app`.
# La web y la API deben compartir "site" (mismo dominio registrable) para que
# la cookie de refresh SameSite=Lax viaje: localhost:5173 y localhost:8000 lo son,
# y en producción ygg.tudominio.dev y api.ygg.tudominio.dev también.
VITE_API_URL=http://localhost:8000

# Demo pública (opcional). Si se definen, el login muestra estas credenciales y
# un botón para entrar. Son públicas a propósito: la API con DEMO_MODE=true es de
# solo lectura. No pongas aquí credenciales de una cuenta real.
# VITE_DEMO_EMAIL=demo@ygg.gg
# VITE_DEMO_PASSWORD=

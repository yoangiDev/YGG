# Copia este fichero a `.env` y rellena los valores. Nunca commitees `.env`.

# Entorno de ejecución: development | test | production
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Cadena de conexión SQLAlchemy a PostgreSQL. Con `make up` es la de abajo.
DATABASE_URL=postgresql://ygg:ygg@localhost:5432/ygg
# Tamaño del pool de conexiones y conexiones extra permitidas en picos.
# Ajústalo al límite de conexiones de tu plan de hosting.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Servicios externos ────────────────────────────────────────────────────────
# Clave de la Riot Games API (https://developer.riotgames.com). La de desarrollo
# caduca cada 24 h. Sin ella la API arranca, pero no puede analizar partidas.
RIOT_API_KEY=
# Redis para caché, rate limiting y cola de trabajos.
REDIS_URL=redis://localhost:6379/0
# Supabase Storage para los avatares. Opcionales: sin ellos el endpoint de
# avatar responde 503.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Clave de firma de los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-en-local
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas. No uses "*".
CORS_ORIGINS=http://localhost:5173

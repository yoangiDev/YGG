# Copia este fichero a `.env` y rellena los valores. Nunca commitees `.env`.

# Entorno de ejecución: development | test | production
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# URL de PostgreSQL. La aplicación la convierte a postgresql+asyncpg (y sslmode a
# ssl); Alembic y los scripts la usan tal cual con psycopg2.
DATABASE_URL=postgresql://ygg:ygg@localhost:5432/ygg
# Pool de conexiones por proceso. Ajústalo al límite de conexiones de tu plan.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Servicios externos ────────────────────────────────────────────────────────
# Clave de la Riot Games API (https://developer.riotgames.com). La de desarrollo
# caduca cada 24 h. Sin ella la API arranca, pero no puede analizar partidas.
RIOT_API_KEY=
# Redis para caché, rate limiting y cola. `memory://` usa un Redis en memoria
# (solo para desarrollo y tests: no se comparte entre procesos).
REDIS_URL=redis://localhost:6379/0
# Supabase Storage para los avatares. Sin ellos el endpoint de avatar da 503.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Clave de firma de los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-en-local
ALGORITHM=HS256
# Access token de vida corta (en memoria del frontend) y refresh token en
# cookie httpOnly, rotado en cada uso.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=ygg_refresh
# Cookie con atributo Secure. Por defecto solo en producción (en local no hay https).
# COOKIE_SECURE=true

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas. No uses "*".
CORS_ORIGINS=http://localhost:5173
# Leer la IP del cliente de X-Forwarded-For. Actívalo solo detrás de tu propio proxy.
TRUST_PROXY_HEADERS=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_EMAIL_PER_HOUR=30
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_SNAPSHOTS_PER_HOUR=20

# ── Caché ─────────────────────────────────────────────────────────────────────
DASHBOARD_CACHE_TTL_SECONDS=86400
DDRAGON_REFRESH_HOURS=6

# ── Observabilidad ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Logs en JSON. Por defecto: JSON salvo en development.
# LOG_JSON=true
# Sentry: sin DSN no se envía nada.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

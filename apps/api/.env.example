# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Runtime environment: development | test | production
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL URL. The application converts it to postgresql+asyncpg (and sslmode to
# ssl); Alembic and the scripts use it as is with psycopg2.
DATABASE_URL=postgresql://ygg:ygg@localhost:5432/ygg
# Connection pool per process. Adjust it to your plan's connection limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── External services ─────────────────────────────────────────────────────────
# Riot Games API key (https://developer.riotgames.com). The development one
# expires every 24 h. Without it the API starts, but it cannot analyse matches.
RIOT_API_KEY=
# Riot key quota. The default values are for the development key
# (20/s and 100 per 2 min, with some margin). With a production key, raise them.
RIOT_REQUESTS_PER_SECOND=10
RIOT_REQUESTS_PER_TWO_MINUTES=70
RIOT_MAX_CONNECTIONS=6
# Current season: Riot changes the dates every year and they are set by hand.
# They mark which matches count in the "This season" section and which are downloaded.
# An empty end means the season is still open.
SEASON_START=2026-01-01T00:00:00Z
# SEASON_END=2026-12-31T23:59:59Z
# Redis for cache, rate limiting and the queue. `memory://` uses an in-memory Redis
# (development and tests only: it is not shared between processes).
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-locally
ALGORITHM=HS256
# Short-lived access token (in the frontend's memory) and refresh token in an
# httpOnly cookie, rotated on every use.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=ygg_refresh
# Cookie with the Secure attribute. By default only in production (locally there is no https).
# COOKIE_SECURE=true

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Origins allowed by CORS, comma-separated. Do not use "*".
CORS_ORIGINS=http://localhost:5173
# Read the client IP from X-Forwarded-For. Turn it on only behind your own proxy.
TRUST_PROXY_HEADERS=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_EMAIL_PER_HOUR=30
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_SNAPSHOTS_PER_HOUR=20

# ── Cache ─────────────────────────────────────────────────────────────────────
DASHBOARD_CACHE_TTL_SECONDS=86400
DDRAGON_REFRESH_HOURS=6

# ── Job queue ─────────────────────────────────────────────────────────────────
# arq: analyses are run by the worker (`arq app.jobs.worker.WorkerSettings`).
# inline: in the API process itself, without a worker (development only). With
# REDIS_URL=memory:// inline is always used.
JOB_BACKEND=arq
WORKER_MAX_JOBS=2
JOB_TIMEOUT_SECONDS=1800
JOB_HEARTBEAT_SECONDS=10
# Without a heartbeat for this long, a running analysis is considered lost.
JOB_STALE_AFTER_SECONDS=60

# ── Match analysis (replays) ──────────────────────────────────────────────────
# The API decodes the .rofl that the user uploads and analyses it in the background, in its own process.
# It needs the external decoder (the `lol-replay-decoder` repo, with its venv and the game's exes) and
# `pip install -r requirements-replays.txt`. Without them the API works the same, but doesn't analyse replays.
# First day with replays and the exe of its patch: the calendar doesn't allow asking earlier.
PREMIUM_SINCE=2026-09-23T00:00:00Z
# Where to look for the decoder and the data. By default, YGG and lol-replay-decoder side by side.
# DECODER_DIR=../lol-replay-decoder
# PREMIUM_DIR=../lol-replay-decoder/data/premium
# GAME_DATA_DIR=C:/Riot Games/League of Legends/Game/DATA/FINAL
# RESEARCH_DIR=./research
DECODE_PROCESSES=4
# Claude's review. Without a key, the analysis is stored with its numbers and without a review.
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-opus-5-5
REVIEW_EFFORT=high

# ── Public demo ───────────────────────────────────────────────────────────────
# Read-only: rejects writes (except login/refresh/logout) and the requests
# that would call the Riot API. The data is seeded with:
#   DEMO_PASSWORD=... python scripts/seed_demo.py
DEMO_MODE=false
# Account created by the seeding script (the password is only passed when running it).
# DEMO_EMAIL=demo@ygg.gg

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# JSON logs. By default: JSON except in development.
# LOG_JSON=true
# Sentry: without a DSN nothing is sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
